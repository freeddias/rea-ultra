Id\":208101,\"templateType\":1,\"count\":300,\"isbind\":true},{\"templateId\":2125123,\"templateType\":1,\"count\":10,\"isbind\":true},{\"templateId\":2126815,\"templateType\":1,\"count\":2,\"isbind\":true}],\"conditions\":[{\"conditionId\":131,\"conditionValue\":3}],\"packageId\":\"C3484C50-78B8-B0E6-4983-38224D835D7A\",\"order\":3},{\"items\":[{\"templateId\":208001,\"templateType\":1,\"count\":10,\"isbind\":true},{\"templateId\":2125084,\"templateType\":1,\"count\":2,\"isbind\":true},{\"templateId\":2126815,\"templateType\":1,\"count\":2,\"isbind\":true}],\"conditions\":[{\"conditionId\":131,\"conditionValue\":2}],\"packageId\":\"D3853BEF-5A0A-2278-870A-38224D832173\",\"order\":2}],\"activeId\":\"8A338CF2-E16A-633F-900D-38224D80CB7E\",\"beginDate\":\"2026-10-22 00:00:00\",\"endDate\":\"2026-10-28 23:59:59\",\"title\":\"<en>7-Day Logins 10/15</en>\\n<es>Acceso de 7 días 10/15</es>\\n<pt>7-Dia Login 10/15</pt>\\n<de>7-tägige Anmeldungen 10/15</de>\\n<fr>Connexion 7J 10/15</fr>\\n<tr>7 Günlük Giriş 10/15</tr>\\n<ru>Вход 7 дней 10/15</ru>\\n<zhtw>七天登錄 10/15</zhtw>\\n<nl>7 Dagen Inloggen 10/15</nl>\\n<id>Login 7 Hari 10/15</id>\\n<th>ล็อกอิน 7 วัน 10/15</th>\\n<pl>Logowanie przez 7 dni 10/15</pl>\",\"detail\":\"<en>During the event, log in to the game daily to obtain rewards.</en>\\n<es>Durante el evento, inicia sesión en el juego diariamente para obtener recompensas.</es>\\n<pt>Durante o evento, faça login no jogo diariamente para obter recompensas.</pt>\\n<de>Melde dich während des Events täglich im Spiel an, um Belohnungen zu bekommen.</de>\\n<fr>Pendant l'événement, connectez-vous quotidiennement au jeu pour obtenir des récompenses.</fr>\\n<tr>Etkinlik süresince her gün oyuna giriş yaparak ödülleri kazanın.</tr>\\n<ru>Во время события заходите в игру в течение X дней для получения наград</ru>\\n<zhtw>活動期間，累計登錄X天，即可獲得相應獎勵。</zhtw>\\n<nl>Tijdens de eventperiode kun je door in totaal X dagen in te loggen de overeenkomstige beloningen ontvangen.</nl>\\n<id>Selama periode event, login total X hari untuk mendapatkan hadiah yang sesuai.</id>\\n<th>ในช่วงระยะเวลากิจกรรม ล็อกอินสะสมครบ X วัน เพื่อรับรางวัลที่สอดคล้องกัน</th>\\n<pl>Podczas trwania wydarzenia zaloguj się łącznie X dni, aby otrzymać odpowiednie nagrody.</pl>\",\"conditionDetail\":\"-\",\"getway\":1,\"activeType\":131,\"startTime\":\"2026-10-22 00:00:00\",\"stopTime\":\"2026-10-28 23:","t":1793140392054,"ua":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36"}
